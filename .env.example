# Copy to .env.local. Every value is optional: with none set, the dashboard
# stays device-local exactly as before and /api/trpc answers "not configured".

# Browser (read at build time) — Supabase project URL and anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Robinhood Chain (4663) RPC endpoint, e.g. Dwellir.
VITE_RPC_URL_4663=
# Deployment manifest JSON (packages/shared/deployments/<chainId>.json); turns on the
# dashboard's on-chain path.
VITE_CORDON_DEPLOYMENT=

# Server (/api/trpc on Vercel). Fall back to the VITE_ values when unset.
SUPABASE_URL=
SUPABASE_ANON_KEY=
